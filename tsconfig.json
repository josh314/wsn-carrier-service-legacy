{
  "compilerOptions": {
    // module options
    "module": "commonjs",
    // folder and file options
    "baseUrl": "src/lib",
    // "outDir": "./dist",
    // strictness
    "noImplicitReturns": true,
    "noImplicitThis": true,
    // "noEmitOnError": true,
    // other
    "sourceMap": true,
    "pretty": true,
    "target": "ESNext",
    "types": [
      "node",
      "aws-lambda",
      "request-promise"
    ]
  }
}