{
  "compilerOptions": {
    // module options
    "module": "commonjs",
    // folder and file options
    "baseUrl": "src/lib",
    // "outDir": "./dist",
    // strictness
    "noEmitOnError": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    // other
    "sourceMap": true,
    "pretty": true,
    "target": "ESNext",
    "types": [
      "node",
      "aws-lambda",
      "request-promise",
      "./src",
      "./src/lib/shopify",
      "./src/lib/ups"
    ]
  }
}