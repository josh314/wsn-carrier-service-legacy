{
  "name": "wsn-carrier-service",
  "version": "2.0.0",
  "description": "Application for supplying shipping rates to Shopify based on custom business logic",
  "scripts": {
    "build-client": "webpack --config webpack.config.js",
    "build-functions": "NODE_ENV=production webpack --config webpack.functions.js",
    "build-scripts": "NODE_ENV=development webpack --config webpack.scripts.js",
    "dev-server": "webpack-dev-server --open --config webpack.config.js",
    "lambda-build": "netlify-lambda build --config webpack.functions.js src/functions",
    "lambda-serve": "netlify-lambda serve --config webpack.functions.js src/functions",
    "ngrok": "ngrok http 8080 --subdomain=josh-wsn -host-header=localhost:8080",
    "start": "bash deploy-local.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@gitlab.com/wazue/wsn-carrier-service.git"
  },
  "author": "Joshua \"El\" Davis <josh314@gmail.com>",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://gitlab.com/wazue/wsn-carrier-service/issues"
  },
  "homepage": "https://gitlab.com/wazue/wsn-carrier-service#readme",
  "dependencies": {
    "@sendgrid/mail": "^6.4.0",
    "@types/aws-lambda": "^8.10.31",
    "@types/request-promise": "^4.1.44",
    "@typescript-eslint/eslint-plugin": "^2.3.0",
    "@typescript-eslint/parser": "^2.3.0",
    "eslint": "^6.1.0",
    "eslint-loader": "^2.2.1",
    "html-webpack-plugin": "^3.2.0",
    "minimist": "^1.2.0",
    "request": "^2.88.0",
    "request-promise": "^4.2.4",
    "ts-loader": "^6.1.2",
    "typescript": "^3.6.3",
    "webpack": "^4.38.0",
    "webpack-cli": "^3.3.6"
  },
  "devDependencies": {
    "dotenv-webpack": "^1.7.0",
    "netlify-lambda": "^1.5.1",
    "shopify-api-node": "^2.23.1",
    "webpack-dev-server": "^3.7.2"
  }
}
